---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Hack The Flag" robots="noindex">


<main class="not-found">
  <p class="not-found-code">404</p>
  <h1>No flag here.</h1>
  <a href="/" class="bracket">Back to Hack The Flag</a>
</main>

</Base>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
  }
  .not-found-code { color: var(--red); font-size: 1rem; letter-spacing: 0.3em; }
  .not-found h1 { font-size: clamp(1.75rem, 5vw, 3rem); font-weight: 400; }
  .not-found a { color: #fff; text-decoration: none; }
</style>
